# Copy to .env and fill in real secrets. Never commit .env.
# --- Production ---
CYSLOP_ENV=production
CYSLOP_JWT_SECRET=generate-with-openssl-rand-hex-32-min-32-chars
CYSLOP_JWT_EXPIRE_MIN=480
FRONTEND_ORIGINS=https://your-frontend-domain
CYSLOP_DB_PATH=/data/cyslop.db
CYSLOP_ANCHOR_PATH=/data/audit_anchor.json
CYSLOP_ANCHOR_URL=
# Users: BADGE:password:role:CASE comma-separated (passwords >= 8 chars). No defaults in prod.
CYSLOP_SEED_USERS=OFFICER-4402:REPLACE-ME-8CHARS:lead_investigator:CAS-2026-102
CYSLOP_LOGIN_MAX_FAILS=5
CYSLOP_LOGIN_LOCKOUT_SECS=300
# --- Local demo only ---
# ALLOW_INSECURE_DEV=1
# CYSLOP_ENV=dev
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CYSLOP_DEMO_PASSWORD=demo-only-change-me
# Legacy placeholders (unused by current SQLite backend, kept for docs)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
POSTGRES_DB=police_analytics
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
